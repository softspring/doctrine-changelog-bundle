{
    "name": "softspring/doctrine-changelog-bundle",
    "description": "Doctrine changelog collect and store into warehouse",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "doctrine/orm": "^2.11 | ^3.0",
        "doctrine/annotations": "^1.11",
        "symfony/config": "^6.4|^7.3",
        "symfony/dependency-injection": "^6.4|^7.3",
        "symfony/http-foundation": "^6.4|^7.3",
        "symfony/http-kernel": "^6.4|^7.3",
        "symfony/security-core": "^6.4|^7.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "google/cloud-bigquery": "^1.0",
        "phpstan/phpstan": "^1.10",
        "rector/rector": "^1.0"
    },
    "suggest": {
        "google/cloud-bigquery": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\DoctrineChangeLogBundle\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
